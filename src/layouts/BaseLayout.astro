---
import { site } from '../config';
import { withBase } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* 字体与全局样式：全部本地依赖，不引用任何外部 CDN */
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  /** 页面标题（不含站名，会自动拼接 · 站名） */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** 不参与索引（404、搜索页等） */
  noindex?: boolean;
  /** 文章页附加的 Open Graph 时间与标签 */
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
  };
}

const {
  title,
  description = site.description,
  type = 'website',
  noindex = false,
  article,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : site.title;
const siteUrl = Astro.site ?? new URL('https://example.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const feedUrl = new URL(withBase('/rss.xml'), siteUrl).toString();
const sitemapUrl = withBase('/sitemap-index.xml');
---

<!doctype html>
<html lang={site.locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- 主题与图标 -->
    <meta name="theme-color" content="#FBFAF7" id="theme-color" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} · RSS`} href={feedUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />

    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />
    {
      type === 'article' && article?.publishedTime && (
        <meta property="article:published_time" content={article.publishedTime} />
      )
    }
    {
      type === 'article' && article?.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )
    }
    {
      type === 'article' &&
        article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <!-- 首屏前确定主题，避免闪烁；localStorage 优先，系统配色兜底 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute('content', theme === 'dark' ? '#0F0F0E' : '#FBFAF7');
          }
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
