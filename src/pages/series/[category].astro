---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {
  getAllPosts,
  getCategories,
  sortSeries,
  tagSlug,
  withBase,
} from '../../lib/site';
import type { Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = getCategories(posts);
  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      name: category.name,
      posts: sortSeries(
        posts.filter((post) => tagSlug(post.data.category ?? '') === category.slug)
      ),
    },
  }));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
const description = `${name}系列，共 ${posts.length} 篇。`;
---

<BaseLayout title={name} description={description}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">系列</p>
      <h1 class="page-title">{name}</h1>
      <p class="page-desc">{description}</p>
    </header>

    <div class="page-body">
      <ul class="post-list">
        {posts.map((post) => <PostCard post={post} showExcerpt={false} />)}
      </ul>

      <p class="page-back">
        <a href={withBase('/series')}>← 全部系列</a>
      </p>
    </div>
  </div>
</BaseLayout>
