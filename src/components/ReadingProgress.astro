---
/**
 * 阅读进度条：固定在视口顶部，随滚动比例伸缩（2px 强调色细线）。
 * 仅在文章详情页渲染。
 */
---

<div class="reading-progress" id="reading-progress" aria-hidden="true">
  <span class="reading-progress-bar" data-progress-bar></span>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');

  if (bar) {
    let ticking = false;

    const update = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, scrollTop / scrollable)) : 0;
      bar.style.transform = `scaleX(${ratio})`;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
