---
/**
 * 深浅色切换按钮。
 * 初始主题由 BaseLayout <head> 中的内联脚本提前写入 <html data-theme>，
 * 这里只负责：同步无障碍状态（aria-label / aria-pressed / meta theme-color）与切换持久化。
 */
---

<button
  class="theme-toggle"
  type="button"
  id="theme-toggle"
  aria-label="切换到深色模式"
  aria-pressed="false"
  title="切换深浅色主题"
>
  <svg
    class="icon icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M21 12.79A8.5 8.5 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
  </svg>
  <svg
    class="icon icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
  </svg>
</button>

<script>
  const THEME_COLORS: Record<string, string> = { light: '#FBFAF7', dark: '#0F0F0E' };
  const THEME_LABELS: Record<string, string> = { light: '切换到深色模式', dark: '切换到浅色模式' };

  function readTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function syncThemeUi(theme: 'light' | 'dark', button: HTMLElement) {
    button.setAttribute('aria-label', THEME_LABELS[theme] ?? '切换深浅色主题');
    button.setAttribute('aria-pressed', String(theme === 'dark'));
    const meta = document.getElementById('theme-color');
    if (meta) meta.setAttribute('content', THEME_COLORS[theme] ?? '#FBFAF7');
  }

  const button = document.getElementById('theme-toggle');

  if (button) {
    syncThemeUi(readTheme(), button);

    button.addEventListener('click', () => {
      const next: 'light' | 'dark' = readTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* 无痕模式等场景下忽略持久化失败 */
      }
      syncThemeUi(next, button);
    });
  }
</script>
