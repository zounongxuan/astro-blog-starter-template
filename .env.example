# ===== Notion 同步（必填）=====
# 1. 打开 https://www.notion.so/my-integrations 新建 integration（Internal）
# 2. 复制 token（secret_ 或 ntn_ 开头）填到下面
# 3. 在 Notion 里打开目标页面/数据库 → 右上角 ··· → 连接 → 添加你的 integration
# 4. 把数据库或页面的链接/ID 填到 NOTION_DATABASE_ID / NOTION_PAGE_ID（二选一）
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PAGE_ID=

# 可选：属性名映射（默认会自动识别 title / date / tags / category / description）
# NOTION_TITLE_PROP=
# NOTION_DATE_PROP=
# NOTION_TAGS_PROP=
# NOTION_CATEGORY_PROP=
# NOTION_DESCRIPTION_PROP=
# NOTION_DRAFT_PROP=

# 可选：是否把 Notion 图片下载到本地（默认 true；false 则直接引用 Notion 临时链接，约 1 小时后过期）
# NOTION_DOWNLOAD_IMAGES=true

# 可选：按标题关键词排除页面（英文逗号分隔，例如 "内部,台账,报价,合同"）
# 被排除的页面不会同步、也不会出现在网站上
# NOTION_EXCLUDE_TITLES=

# 可选：push:api 兜底推送用的 GitHub token（git push 网络不稳定时使用）
# GITHUB_TOKEN=github_pat_xxx

# 可选：站点 URL 与部署子路径（本地一般不用填；Actions 会自动注入）
# SITE_URL=https://yourname.github.io/repo
# BASE_PATH=/repo
